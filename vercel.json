{
  "rewrites": [
    {
      "source": "/beachcomber",
      "destination": "/index.html"
    },
    {
      "source": "/beachcomber/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
